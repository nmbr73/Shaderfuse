    InFANG_StainColorG = self:AddInput("Green", "FANG_StainGreen", { INP_Default  = 0.022, IC_ControlID = 1, attrs})
    InFANG_StainColorB = self:AddInput("Blue",  "FANG_StainBlue",  { INP_Default  = 0.014, IC_ControlID = 2, attrs})
    InFANG_StainColorA = self:AddInput("Alpha", "FANG_StainAlpha", { INP_Default  = 1.0, IC_ControlID = 3, attrs})

