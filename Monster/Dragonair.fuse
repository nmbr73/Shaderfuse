    InWater2ColorColorB = self:AddInput("Blue",  "Water2ColorBlue",  { INP_Default  = 1.0, IC_ControlID = 2, attrs})
    InWater2ColorColorA = self:AddInput("Alpha", "Water2ColorAlpha", { INP_Default  = 1.0, IC_ControlID = 3, attrs})

  self:EndControlNest()

  self:BeginControlNest("MatBlueColor", "MatBlueColor", true, {})

    ctrl_grp_cnt = (ctrl_grp_cnt==nil) and 1 or (ctrl_grp_cnt+1)

