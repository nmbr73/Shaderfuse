    }

    InBellyColorColorR = self:AddInput("Red",   "BellyColorRed",   { INP_Default  = 0.95, IC_ControlID = 0, attrs})
    InBellyColorColorG = self:AddInput("Green", "BellyColorGreen", { INP_Default  = 0.95, IC_ControlID = 1, attrs})
