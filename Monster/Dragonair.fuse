    }

    InMatWhiteColorColorR = self:AddInput("Red",   "MatWhiteColorRed",   { INP_Default  = 0.1, IC_ControlID = 0, attrs})
    InMatWhiteColorColorG = self:AddInput("Green", "MatWhiteColorGreen", { INP_Default  = 0.1, IC_ControlID = 1, attrs})
    InMatWhiteColorColorB = self:AddInput("Blue",  "MatWhiteColorBlue",  { INP_Default  = 0.1, IC_ControlID = 2, attrs})
    InMatWhiteColorColorA = self:AddInput("Alpha", "MatWhiteColorAlpha", { INP_Default  = 1.0, IC_ControlID = 3, attrs})

  self:EndControlNest()

  self:BeginControlNest("MatOrb1Color", "MatOrb1Color", true, {})

    ctrl_grp_cnt = (ctrl_grp_cnt==nil) and 1 or (ctrl_grp_cnt+1)

    attrs = {
      ICS_Name = "MatOrb1Color",
      LINKID_DataType = "Number",
