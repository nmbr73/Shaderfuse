-- // Create
-- // ------------------------------------------------------------------------

function Create()

  ShaderFuse.begin_create()

  ----- Inspector Panel Controls

  
  -- Speed Slider
  
  InFrequency = self:AddInput("Speedup", "speed", {
    LINKID_DataType    = "Number",
    INPID_InputControl = "SliderControl",
    INP_Default        = 1.0,
    INP_MinScale 	     = 0.0,
    INP_MaxScale 	     = 5.0,
    SLCS_LowName       = "stop",
    SLCS_HighName      = "5x",
  })
  
  -- iMouse Controls
  
  InMouseXY = self:AddInput("iMouse.xy", "iMouseXY", {
    LINKID_DataType = "Point",
    INPID_InputControl = "OffsetControl",
    INP_DoNotifyChanged  = false,
    --INP_Passive = true,
    INPID_PreviewControl = "CrosshairControl",
  })
  
  InMouseZW = self:AddInput("iMouse.zw", "iMouseZW", {
    LINKID_DataType = "Point",
    INPID_InputControl = "OffsetControl",
    INP_DoNotifyChanged  = false,
    --INP_Passive = true,
    INPID_PreviewControl = "CrosshairControl",
    INP_Disabled = true,
  })
  
  InMouseDrag = self:AddInput("Mouse Button Pressed", "iMouseClick", {
    LINKID_DataType = "Number",
    INPID_InputControl = "CheckboxControl",
    INP_DoNotifyChanged  = false,
    --INP_Passive = true,
    INP_MinScale = 0,
    INP_MaxScale = 1,
    INP_Default = 0,
  })
  InBKGCheckbox = self:AddInput("BKG", "BKG", {
    LINKID_DataType     = "Number",
    INPID_InputControl  = "CheckboxControl",
    INP_Integer         = true,
    INP_Default         = 1,
  })

  self:BeginControlNest("Colors", "Colors", false, {})
  self:BeginControlNest("ColorDif1", "ColorDif1", true, {})

    ctrl_grp_cnt = (ctrl_grp_cnt==nil) and 1 or (ctrl_grp_cnt+1)

    attrs = {
      ICS_Name = "ColorDif1",
      LINKID_DataType = "Number",
      INPID_InputControl = "ColorControl",
      INP_MinScale = 0.0,
      INP_MaxScale = 1.0,
      IC_ControlGroup = ctrl_grp_cnt,
    }

    InColorDif1ColorR = self:AddInput("Red",   "ColorDif1Red",   { INP_Default  = -0.5, IC_ControlID = 0, attrs})
    InColorDif1ColorG = self:AddInput("Green", "ColorDif1Green", { INP_Default  = -0.5, IC_ControlID = 1, attrs})
    InColorDif1ColorB = self:AddInput("Blue",  "ColorDif1Blue",  { INP_Default  = -0.5, IC_ControlID = 2, attrs})
    InColorDif1ColorA = self:AddInput("Alpha", "ColorDif1Alpha", { INP_Default  = 1.0, IC_ControlID = 3, attrs})

  self:EndControlNest()

  self:BeginControlNest("ColorDif2", "ColorDif2", true, {})

    ctrl_grp_cnt = (ctrl_grp_cnt==nil) and 1 or (ctrl_grp_cnt+1)

    attrs = {
      ICS_Name = "ColorDif2",
      LINKID_DataType = "Number",
      INPID_InputControl = "ColorControl",
      INP_MinScale = 0.0,
      INP_MaxScale = 1.0,
      IC_ControlGroup = ctrl_grp_cnt,
    }

    InColorDif2ColorR = self:AddInput("Red",   "ColorDif2Red",   { INP_Default  = 1.0, IC_ControlID = 0, attrs})
    InColorDif2ColorG = self:AddInput("Green", "ColorDif2Green", { INP_Default  = 1.0, IC_ControlID = 1, attrs})
    InColorDif2ColorB = self:AddInput("Blue",  "ColorDif2Blue",  { INP_Default  = 0.9, IC_ControlID = 2, attrs})
    InColorDif2ColorA = self:AddInput("Alpha", "ColorDif2Alpha", { INP_Default  = 1.0, IC_ControlID = 3, attrs})

  self:EndControlNest()

  self:BeginControlNest("ColorDif3", "ColorDif3", true, {})

    ctrl_grp_cnt = (ctrl_grp_cnt==nil) and 1 or (ctrl_grp_cnt+1)

    attrs = {
      ICS_Name = "ColorDif3",
      LINKID_DataType = "Number",
      INPID_InputControl = "ColorControl",
      INP_MinScale = 0.0,
      INP_MaxScale = 1.0,
      IC_ControlGroup = ctrl_grp_cnt,
    }

    InColorDif3ColorR = self:AddInput("Red",   "ColorDif3Red",   { INP_Default  = 0.8, IC_ControlID = 0, attrs})
    InColorDif3ColorG = self:AddInput("Green", "ColorDif3Green", { INP_Default  = 0.8, IC_ControlID = 1, attrs})
    InColorDif3ColorB = self:AddInput("Blue",  "ColorDif3Blue",  { INP_Default  = 0.8, IC_ControlID = 2, attrs})
    InColorDif3ColorA = self:AddInput("Alpha", "ColorDif3Alpha", { INP_Default  = 1.0, IC_ControlID = 3, attrs})

  self:EndControlNest()

  self:BeginControlNest("ColorBKG1", "ColorBKG1", true, {})

    ctrl_grp_cnt = (ctrl_grp_cnt==nil) and 1 or (ctrl_grp_cnt+1)

    attrs = {
      ICS_Name = "ColorBKG1",
      LINKID_DataType = "Number",
      INPID_InputControl = "ColorControl",
      INP_MinScale = 0.0,
      INP_MaxScale = 1.0,
      IC_ControlGroup = ctrl_grp_cnt,
    }

    InColorBKG1ColorR = self:AddInput("Red",   "ColorBKG1Red",   { INP_Default  = 0.7, IC_ControlID = 0, attrs})
