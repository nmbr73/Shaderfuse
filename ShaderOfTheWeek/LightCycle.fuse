    InCol_ORANGE2ColorG = self:AddInput("Green", "Col_ORANGE2Green", { INP_Default  = 0.65, IC_ControlID = 1, attrs})
    InCol_ORANGE2ColorB = self:AddInput("Blue",  "Col_ORANGE2Blue",  { INP_Default  = 0.25, IC_ControlID = 2, attrs})
    InCol_ORANGE2ColorA = self:AddInput("Alpha", "Col_ORANGE2Alpha", { INP_Default  = 1.0, IC_ControlID = 3, attrs})

