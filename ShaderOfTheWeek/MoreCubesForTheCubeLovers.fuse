    InBKG1ColorR = self:AddInput("Red",   "BKG1Red",   { INP_Default  = 0.0, IC_ControlID = 0, attrs})
    InBKG1ColorG = self:AddInput("Green", "BKG1Green", { INP_Default  = 0.25, IC_ControlID = 1, attrs})
    InBKG1ColorB = self:AddInput("Blue",  "BKG1Blue",  { INP_Default  = -1.0, IC_ControlID = 2, attrs})
